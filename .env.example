# Copy to `.env` at the repository root and fill in values.
# Never commit `.env` — it is gitignored.

# --- OpenAI (LLM + optional diarized STT) ---
# Required for field extraction, meeting intel, and assessment reports.
# Also required when STT_BACKEND=openai_diarize.
OPENAI_API_KEY=sk-your-openai-api-key-here

LLM_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

# --- Speech-to-text ---
# whisper = local Whisper (lazy model load)
# openai_diarize = OpenAI API transcription (no local Whisper/PyTorch load)
STT_BACKEND=whisper
WHISPER_MODEL_SIZE=base

# --- FFmpeg / ffprobe (optional) ---
# Use when binaries are not on PATH (common on Windows).
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# --- Pyannote / Hugging Face diarization (optional) ---
# Pipeline diarization may still be off until Hub models are enabled.
ENABLE_DIARIZATION=false
# DIARIZATION_HF_TOKEN=hf_your_huggingface_token_here

# --- Pipeline ---
# Reuse existing on-disk artifacts to skip completed stages when true.
PIPELINE_RESUME=false
PIPELINE_VERSION=2.1

# --- CLI input (optional) ---
# Used when running `python -m app.main` with no positional path.
# Checked in order: PIPELINE_INPUT, then VIDEO_PATH, then CALL_MEDIA_PATH.
# PIPELINE_INPUT=data/uploads/my_recording.mp4
# VIDEO_PATH=
# CALL_MEDIA_PATH=

# --- Streamlit uploads ---
# App-side upload cap in megabytes. Keep in sync with `.streamlit/config.toml`
# `[server] maxUploadSize` (also overridable via STREAMLIT_SERVER_MAX_UPLOAD_SIZE).
STREAMLIT_MAX_UPLOAD_MB=8192

# --- Logging & tuning ---
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.80
